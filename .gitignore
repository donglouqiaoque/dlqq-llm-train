#----------忽略区----------
# 忽略Python字节码缓存文件（用PyCharm提交推送的话不需要忽略）
__pycache__
# 忽略idea自身
.idea
# 忽略AI临时目录（整个目录，不参与训练、不进版本库）
.ai_res
# 训练缓存目录：保留目录本身（.gitkeep），只忽略内容
.cache/*
# 忽略除chat_demo以外的模型（模型文件太大Gitee不让上传）
model/*
model/**/checkpoint*
# 语料目录：保留目录本身，语料内容不进版本库
res/*
# 忽略快捷方式（快捷方式不通用）
*.lnk
# 忽略Python运行环境（Python运行环境在Release包中提供，仓库里面不包含）
.runtime/python
#-------------------------

#----------排除区----------
# 排除.gitkeep（用于保留空目录）
!.gitkeep
# 排除chat_demo模型
!chat_demo*
#-------------------------
